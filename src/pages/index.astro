---
import Layout from '../layouts/Layout.astro';
import { ContactForm } from '../components/ContactForm';

const features = [
  {
    title: "Recordatorios ilimitados",
    description: "Programa alertas recurrentes o puntuales para eventos críticos y seguimiento de tareas.",
    badge: "Escalabilidad"
  },
  {
    title: "Sincronización con Google Calendar",
    description: "Conecta los calendarios del equipo y dispara alarmas automáticas directo a WhatsApp.",
    badge: "Integración"
  },
  {
    title: "Gestión multi-usuario",
    description: "Configura canales, grupos y asignaciones individuales por departamento o sucursal.",
    badge: "Colaboración"
  },
  {
    title: "Historial y trazabilidad",
    description: "Auditoría en tiempo real de estados de entrega, lectura y confirmación de mensajes.",
    badge: "Control"
  }
];

const tiers = [
  {
    name: "Pro",
    price: "USD 3",
    period: "/mes",
    description: "Para profesionales independientes y microequipos operativos.",
    features: ["Hasta 3 usuarios", "1,000 recordatorios/mes", "Google Calendar Sync", "Soporte estándar"],
    cta: "Empezar prueba",
    highlight: false
  },
  {
    name: "Business",
    price: "USD 9",
    period: "/mes",
    description: "Para equipos medianos que requieren trazabilidad continua.",
    features: ["Hasta 15 usuarios", "Recordatorios ilimitados", "Multi-calendario", "Logs de auditoría", "Soporte prioritario"],
    cta: "Elegir Business",
    highlight: true
  },
  {
    name: "Enterprise",
    price: "Custom",
    period: "",
    description: "Infraestructura dedicada, SLA garantizado y seguridad corporativa.",
    features: ["Usuarios ilimitados", "API y Webhooks dedicados", "SLA 99.9% de entrega", "Manager de cuenta asignado"],
    cta: "Contactar ventas",
    highlight: false
  }
];
---

<Layout title="Whatalarm.io | Automatiza recordatorios críticos para tu equipo">
  {/* Hero Section */}
  <section class="relative py-20 lg:py-28 overflow-hidden bg-slate-900 text-white">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-5xl mx-auto px-6 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs font-semibold text-blue-400 mb-6">
        WhatsApp Business API • Confiabilidad 99.9%
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white mb-6">
        Automatiza recordatorios críticos para tu equipo
      </h1>
      <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Reduce ausencias y retrasos operacionales enviando alertas directas al canal que todos leen en tiempo real.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#contact" class="w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg text-base transition-colors shadow-sm">
          Solicitar demo gratis
        </a>
        <a href="#pricing" class="w-full sm:w-auto px-8 py-3.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-lg text-base border border-slate-700 transition-colors">
          Ver planes
        </a>
      </div>
    </div>
  </section>

  {/* Problema / Solución */}
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl mb-16">
        <h2 class="text-sm font-bold uppercase tracking-wider text-blue-600 mb-2">Por qué Whatalarm</h2>
        <p class="text-3xl font-bold text-slate-900">Diseñado para la continuidad operativa de negocios</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 rounded-xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 bg-blue-100 text-blue-700 rounded-lg flex items-center justify-center font-bold mb-4">01</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Máxima tasa de apertura</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Los correos se pierden en el spam. WhatsApp garantiza que las alertas críticas sean vistas en menos de 3 minutos.</p>
        </div>
        <div class="p-8 rounded-xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 bg-blue-100 text-blue-700 rounded-lg flex items-center justify-center font-bold mb-4">02</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Seguridad y cifrado</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Infraestructura sobre la API oficial de WhatsApp Cloud. Protección de datos empresariales de extremo a extremo.</p>
        </div>
        <div class="p-8 rounded-xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 bg-blue-100 text-blue-700 rounded-lg flex items-center justify-center font-bold mb-4">03</div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Cero fricción de adopción</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Tu equipo no necesita instalar software adicional. Solo configuran sus eventos y reciben alertas en su app diaria.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Features */}
  <section id="features" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-sm font-bold uppercase tracking-wider text-blue-600 mb-2">Funcionalidades</h2>
        <p class="text-3xl font-bold text-slate-900">Todo lo necesario para coordinar operaciones</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {features.map((feature) => (
          <div class="p-6 bg-white rounded-xl border border-slate-200 flex flex-col justify-between hover:border-slate-300 transition-colors">
            <div>
              <span class="inline-block px-2.5 py-1 bg-slate-100 text-slate-600 text-xs font-semibold rounded mb-4">
                {feature.badge}
              </span>
              <h3 class="text-base font-bold text-slate-900 mb-2">{feature.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Testimonial Placeholder */}
  <section class="py-16 bg-white border-y border-slate-200">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <blockquote class="text-xl md:text-2xl font-medium text-slate-800 italic mb-6">
        "Implementar Whatalarm redujo un 40% las ausencias a reuniones clave y aceleró la confirmación de guardias técnicas en nuestros equipos de soporte."
      </blockquote>
      <p class="font-bold text-slate-900 text-sm">Dirección de Operaciones</p>
      <p class="text-slate-500 text-xs">Empresa de Servicios Logísticos B2B</p>
    </div>
  </section>

  {/* Pricing */}
  <section id="pricing" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-sm font-bold uppercase tracking-wider text-blue-600 mb-2">Precios</h2>
        <p class="text-3xl font-bold text-slate-900">Planes transparentes escalables a tu ritmo</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8 items-stretch">
        {tiers.map((tier) => (
          <div class={`p-8 rounded-2xl flex flex-col justify-between bg-white border ${tier.highlight ? 'border-blue-600 ring-2 ring-blue-600 shadow-md' : 'border-slate-200'}`}>
            <div>
              <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-bold text-slate-900">{tier.name}</h3>
                {tier.highlight && <span class="px-2.5 py-0.5 bg-blue-100 text-blue-700 text-xs font-bold rounded-full">Popular</span>}
              </div>
              <div class="flex items-baseline gap-1 mb-4">
                <span class="text-4xl font-bold text-slate-900">{tier.price}</span>
                <span class="text-slate-500 text-sm">{tier.period}</span>
              </div>
              <p class="text-sm text-slate-600 mb-6">{tier.description}</p>
              <ul class="space-y-3 mb-8 text-sm text-slate-600">
                {tier.features.map((feat) => (
                  <li class="flex items-center gap-2">
                    <span class="text-blue-600 font-bold">✓</span> {feat}
                  </li>
                ))}
              </ul>
            </div>
            <a href="#contact" class={`w-full py-2.5 text-center font-semibold rounded-lg text-sm transition-colors ${tier.highlight ? 'bg-blue-600 hover:bg-blue-700 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-900'}`}>
              {tier.cta}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA & Contact Form */}
  <section id="contact" class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Comienza a optimizar tus alertas hoy</h2>
        <p class="text-slate-600 text-base">Solicita acceso inmediato o coordina una sesión de integración con nuestro equipo técnico.</p>
      </div>
      <ContactForm client:visible />
    </div>
  </section>
</Layout>